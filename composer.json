{
    "name": "eximius/citation-generator",
    "description": "Standalone citation generator",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "laminas/laminas-escaper": "^2.14",
        "psr/log": "^3.0",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "CodeIgniter\\": "system/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "scripts": {
        "test": "php tests/citation/run.php"
    }
}
